<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="0" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox
            x:Name="QueryBox"
            Grid.Row="0"
            Margin="14,14,14,6"
            PlaceholderText="Search apps, clipboard, snippets, the web…"
            IsSpellCheckEnabled="False"
            TextChanged="QueryBox_TextChanged"
            KeyDown="QueryBox_KeyDown"
            CornerRadius="6"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
            FontSize="14" />

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            Margin="14,0,14,0"
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Message="Starting embedded Racket CS…" />

        <StackPanel
            x:Name="AiPanel"
            Grid.Row="2"
            Margin="14,6,14,4"
            Spacing="6"
            Visibility="Collapsed">
            <TextBlock
                x:Name="AiPhase"
                Text="AI is answering…"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource SystemAccentColor}"
                Opacity="0.8" />
            <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                <TextBlock
                    x:Name="AiText"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True"
                    FontSize="13"
                    LineHeight="20" />
            </ScrollViewer>
        </StackPanel>

        <StackPanel
            x:Name="DetailPanel"
            Grid.Row="2"
            Margin="14,6,14,4"
            Spacing="6"
            Visibility="Collapsed">
            <TextBlock
                x:Name="DetailHeader"
                Text="Details"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource SystemAccentColor}"
                Opacity="0.8" />
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="DetailText"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        FontSize="13" />
                    <ItemsControl x:Name="DetailMetadata">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" FontSize="11" Opacity="0.6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

        <ListView
            x:Name="ResultsList"
            Grid.Row="4"
            Margin="6,4,6,0"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="ResultsList_ItemClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="Margin" Value="4,1,4,1"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Grid Margin="12,8,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{Binding}"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            FontSize="13"
                            FontWeight="Medium"
                            VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="HintBar"
            Grid.Row="5"
            Margin="14,4,14,8"
            Opacity="0.45"
            FontSize="11"
            Text="↑↓ navigate · ↵ run · ctrl+k actions · esc hide — Fulcrum" />
    </Grid>
</Window>
