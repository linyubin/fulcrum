01, \\\"milliseconds\\\": 0.001,\\n            \\\"s\\\": 1.0, \\\"sec\\\": 1.0, \\\"second\\\": 1.0, \\\"seconds\\\": 1.0,\\n            \\\"min\\\": 60.0, \\\"minute\\\": 60.0, \\\"minutes\\\": 60.0,\\n            \\\"h\\\": 3600.0, \\\"hr\\\": 3600.0, \\\"hour\\\": 3600.0, \\\"hours\\\": 3600.0,\\n            \\\"d\\\": 86400.0, \\\"day\\\": 86400.0, \\\"days\\\": 86400.0,\\n            \\\"wk\\\": 604800.0, \\\"week\\\": 604800.0, \\\"weeks\\\": 604800.0,\\n        },\\n        \\\"suggest\\\": [\\\"min\\\", \\\"h\\\", \\\"d\\\", \\\"ms\\\", \\\"wk\\\"],\\n    },\\n    \\\"speed\\\": {\\n        \\\"base\\\": \\\"mps\\\",\\n        \\\"units\\\": {\\n            \\\"mps\\\": 1.0, \\\"m/s\\\": 1.0,\\n            \\\"kmh\\\": 0.2777777778, \\\"kph\\\": 0.2777777778, \\\"km/h\\\": 0.2777777778,\\n            \\\"mph\\\": 0.44704,\\n            \\\"knot\\\": 0.5144444444, \\\"knots\\\": 0.5144444444, \\\"kn\\\": 0.5144444444,\\n            \\\"fps\\\": 0.3048, \\\"ft/s\\\": 0.3048,\\n        },\\n        \\\"suggest\\\": [\\\"kmh\\\", \\\"mph\\\", \\\"mps\\\", \\\"knot\\\", \\\"fps\\\"],\\n    },\\n    \\\"area\\\": {\\n        \\\"base\\\": \\\"m2\\\",\\n        \\\"units\\\": {\\n            \\\"m2\\\": 1.0, \\\"sqm\\\": 1.0,\\n            \\\"km2\\\": 1e6, \\\"sqkm\\\": 1e6,\\n            \\\"ft2\\\": 0.09290304, \\\"sqft\\\": 0.09290304,\\n            \\\"mi2\\\": 2589988.110336, \\\"sqmi\\\": 2589988.110336,\\n            \\\"acre\\\": 4046.8564224, \\\"acres\\\": 4046.8564224,\\n            \\\"ha\\\": 10000.0, \\\"hectare\\\": 10000.0, \\\"hectares\\\": 10000.0,\\n        },\\n        \\\"suggest\\\": [\\\"sqft\\\", \\\"sqm\\\", \\\"acre\\\", \\\"ha\\\", \\\"sqkm\\\"],\\n    },\\n}\\n\\n# Temperature is affine, not proportional: value in the unit's own scale.\\nTEMPERATURE = {\\n    \\\"c\\\": 0.0, \\\"celsius\\\": 0.0,\\n    \\\"f\\\": 32.0, \\\"fahrenheit\\\": 32.0,\\n    \\\"k\\\": 273.15, \\\"kelvin\\\": 273.15,\\n}\\nTEMP_SUGGEST = [\\\"c\\\", \\\"f\\\", \\\"k\\\"]\\n\\n\\ndef to_celsius(value, unit):\\n    if unit in (\\\"c\\\", \\\"celsius\\\"):\\n        return value\\n    if unit in (\\\"f\\\", \\\"fahrenheit\\\"):\\n        return (value - 32.0) * 5.0 / 9.0\\n    return value - 273.15\\n\\n\\ndef from_celsius(celsius, unit):\\n    if unit in (\\\"c\\\", \\\"celsius\\\"):\\n        return celsius\\n    if unit in (\\\"f\\\", \\\"fahrenheit\\\"):\\n        return celsius * 9.0 / 5.0 + 32.0\\n    return celsius + 273.15\\n\\n\\ndef find_unit(token):\\n    token = token.lower().strip()\\n    for dimension, spec in DIMENSIONS.items():\\n        if token in spec[\\\"units\\\"]:\\n            return dimension, token\\n    if token in TEMPERATURE:\\n        return \\\"temperature\\\", token\\n    return None, None\\n\\n\\ndef format_number(value):\\n    if value == 0:\\n        return \\\"0\\\"\\n    if abs(value) >= 1e15 or (abs(value) < 1e-4 and value != 0):\\n        return f\\\"{value:.6g}\\\"\\n    if abs(value - round(value)) < 1e-9:\\n        return str(int(round(value)))\\n    return f\\\"{value:.4f}\\\".rstrip(\\\"0\\\").rstrip(\\\".\\\")\\n\\n\\ndef result_row(title, subtitle, arg):\\n    return {\\\"title\\\": title, \\\"subtitle\\\": subtitle, \\\"arg\\\": arg, \\\"icon\\\": \\\"plugin\\\"}\\n\\n\\ndef parse_query(text):\\n    \\\"\\\"\\\"Return (value, from_unit, to_unit) or None. Accepts\\n    \\\"5 km in mi\\\", \\\"100kg to lb\\\", \\\"32 f in c\\\", \\\"5 km\\\".\\\"\\\"\\\"\\n    tokens = text.split()\\n    if not tokens:\\n        return None\\n    try:\\n        value = float(tokens[0].replace(\\\",\\\", \\\"\\\"))\\n    except ValueError:\\n        return None\\n    if len(tokens) < 2:\\n        return None\\n    dimension, from_unit = find_unit(tokens[1])\\n    if from_unit is None:\\n        return None\\n    to_unit = None\\n    if len(tokens) >= 3:\\n        rest = tokens[2:]\\n        # Drop a separator token: in / to / -> / → / as.\\n        if rest and rest[0].lower() in (\\\"in\\\", \\\"to\\\", \\\"->\\\", \\\"→\\\", \\\"as\\\"):\\n            rest = rest[1:]\\n        if rest:\\n            _, to_unit = find_unit(rest[0])\\n            if to_unit is None:\\n                return None\\n    return value, dimension, from_unit, to_unit\\n\\n\\ndef handle_query(query):\\n    text = query.strip()\\n    if not text:\\n        return [result_row(\\n            \\\"Unit converter\\\",\\n            \\\"u 5 km in mi · u 100 kg to lb · u 72 f\\\", \\\"\\\")]\\n\\n    parsed = parse_query(text)\\n    if parsed is None:\\n        return [result_row(\\n            \\\"No conversion found\\\",\\n            \\\"Try: u 5 km in mi · u 3 lb to kg · u 72 f\\\", \\\"\\\")]\\n\\n    value, dimension, from_unit, to_unit = parsed\\n\\n    if dimension == \\\"temperature\\\":\\n        celsius = to_celsius(value, from_unit)\\n        targets = [to_unit] if to_unit else [\\n            u for u in TEMP_SUGGEST if u != from_unit]\\n        rows = []\\n        for target in targets:\\n            converted = from_celsius(celsius, target)\\n            title = f\\\"{format_number(value)}°{from_unit.upper()[0]} = {format_number(converted)}°{target.upper()[0]}\\\"\\n            rows.append(result_row(\\n                title if target != \\\"k\\\" else title.replace(\\\"°K\\\", \\\"K\\\"),\\n                f\\\"Temperature · {from_unit} → {target}\\\",\\n                format_number(converted)))\\n        return rows\\n\\n    spec = DIMENSIONS[dimension]\\n    base_value = value * spec[\\\"units\\\"][from_unit]\\n    targets = [to_unit] if to_unit else [\\n        u for u in spec[\\\"suggest\\\"] if u != from_unit]\\n    rows = []\\n    for target in targets:\\n        converted = base_value / spec[\\\"units\\\"][target]\\n        rows.append(result_row(\\n            f\\\"{format_number(value)} {from_unit} = {format_number(converted)} {target}\\\",\\n            f\\\"{dimension.capitalize()} · {from_unit} → {target}\\\",\\n            f\\\"{format_number(converted)} {target}\\\"))\\n    return rows\\n\\n\\ndef copy_to_clipboard(text):\\n    for command in ([\\\"pbcopy\\\"], [\\\"wl-copy\\\"], [\\\"xclip\\\", \\\"-selection\\\", \\\"clipboard\\\"],\\n                    [\\\"clip.exe\\\"]):\\n        if shutil.which(command[0]):\\n            try:\\n                subprocess.run(command, input=text.encode(\\\"utf-8\\\"),\\n                               check=True, timeout=5)\\n                return True\\n            except (subprocess.SubprocessError, OSError):\\n                continue\\n    return False\\n\\n\\ndef handle_run(arg):\\n    if copy_to_clipboard(arg):\\n        return {\\\"status\\\": \\\"ok\\\", \\\"message\\\": arg}\\n    return {\\\"status\\\": \\\"error\\\", \\\"message\\\": \\\"no clipboard tool found\\\"}\\n\\n\\ndef main():\\n    try:\\n        request = json.loads(sys.stdin.readline())\\n    except (ValueError, json.JSONDecodeError):\\n        print(json.dumps({\\\"request_id\\\": 0, \\\"status\\\": \\\"error\\\",\\n                          \\\"message\\\": \\\"invalid request\\\"}))\\n        return\\n    request_id = request.get(\\\"request_id\\\", 0)\\n    try:\\n        if request.get(\\\"op\\\") == \\\"query\\\":\\n            response = {\\\"request_id\\\": request_id,\\n                        \\\"results\\\": handle_query(request.get(\\\"query\\\", \\\"\\\"))}\\n        elif request.get(\\\"op\\\") == \\\"run\\\":\\n            response = {\\\"request_id\\\": request_id}\\n            response.update(handle_run(request.get(\\\"arg\\\", \\\"\\\")))\\n        else:\\n            response = {\\\"request_id\\\": request_id, \\\"status\\\": \\\"error\\\",\\n                        \\\"message\\\": f\\\"unknown op: {request.get('op')}\\\"}\\n    except Exception as exc:  # never crash the protocol\\n        response = {\\\"request_id\\\": request_id, \\\"status\\\": \\\"error\\\",\\n                    \\\"message\\\": str(exc)}\\n    print(json.dumps(response))\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"},\"uuid\":{\"manifest.json\":\"{\\n  \\\"id\\\": \\\"uuid\\\",\\n  \\\"name\\\": \\\"UUID\\\",\\n  \\\"version\\\": \\\"1.0.0\\\",\\n  \\\"author\\\": \\\"Fulcrum\\\",\\n  \\\"category\\\": \\\"Developer\\\",\\n  \\\"description\\\": \\\"Random v4 UUIDs, one or several, lowercase or `up`. Type `uuid`, `uuid 5`, or `uuid up`.\\\",\\n  \\\"icon\\\": \\\"plugin\\\",\\n  \\\"entry\\\": {\\n    \\\"exec\\\": [\\n      \\\"python3\\\",\\n      \\\"uuidgen.py\\\"\\n    ]\\n  },\\n  \\\"commands\\\": [\\n    {\\n      \\\"id\\\": \\\"generate\\\",\\n      \\\"name\\\": \\\"Generate UUIDs\\\",\\n      \\\"keyword\\\": \\\"uuid\\\",\\n      \\\"description\\\": \\\"uuid 3\\\",\\n      \\\"example\\\": \\\"uuid 3\\\"\\n    }\\n  ],\\n  \\\"permissions\\\": [\\n    \\\"clipboard-write\\\"\\n  ]\\n}\\n\",\"uuidgen.py\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"UUID — Fulcrum plugin (FPP1).\\n\\nFresh random (v4) UUIDs. `uuid` makes one, `uuid 5` makes five, `uuid up`\\nmakes an uppercase one. ↵ copies the selected UUID. Offline.\\n\\\"\\\"\\\"\\n\\nimport json\\nimport subprocess\\nimport sys\\nimport uuid as uuid_module\\n\\n\\ndef row(title, subtitle, arg):\\n    return {\\\"title\\\": title, \\\"subtitle\\\": subtitle, \\\"arg\\\": arg, \\\"icon\\\": \\\"plugin\\\"}\\n\\n\\ndef copy_to_clipboard(text):\\n    for command in ([\\\"pbcopy\\\"], [\\\"wl-copy\\\"], [\\\"xclip\\\", \\\"-selection\\\", \\\"clipboard\\\"],\\n                    [\\\"clip.exe\\\"]):\\n        try:\\n            subprocess.run(command, input=text.encode(\\\"utf-8\\\"), check=True,\\n                           timeout=2, stdout=subprocess.DEVNULL,\\n                           stderr=subprocess.DEVNULL)\\n            return True\\n        except (OSError, subprocess.SubprocessError):\\n            continue\\n    return False\\n\\n\\ndef handle_query(query):\\n    tokens = query.strip().lower().split()\\n    count = 1\\n    upper = False\\n    for token in tokens:\\n        if token.isdigit():\\n            count = max(1, min(10, int(token)))\\n        elif token in (\\\"up\\\", \\\"upper\\\", \\\"uppercase\\\"):\\n            upper = True\\n    rows = []\\n    for index in range(count):\\n        value = str(uuid_module.uuid4())\\n        if upper:\\n            value = value.upper()\\n        label = \\\"UUID v4 · ↵ copies\\\" if count == 1 else f\\\"UUID v4 #{index + 1} · ↵ copies\\\"\\n        rows.append(row(value, label, value))\\n    return rows\\n\\n\\ndef handle_run(arg):\\n    if not arg:\\n        return {\\\"status\\\": \\\"error\\\", \\\"message\\\": \\\"nothing to copy\\\"}\\n    if copy_to_clipboard(arg):\\n        return {\\\"status\\\": \\\"ok\\\"}\\n    return {\\\"status\\\": \\\"error\\\", \\\"message\\\": \\\"no clipboard tool found\\\"}\\n\\n\\ndef main():\\n    for line in sys.stdin:\\n        line = line.strip()\\n        if not line:\\n            continue\\n        try:\\n            request = json.loads(line)\\n        except json.JSONDecodeError:\\n            continue\\n        request_id = request.get(\\\"request_id\\\", 0)\\n        op = request.get(\\\"op\\\")\\n        if op == \\\"query\\\":\\n            response = {\\\"request_id\\\": request_id,\\n                        \\\"results\\\": handle_query(str(request.get(\\\"query\\\", \\\"\\\")))}\\n        elif op == \\\"run\\\":\\n            response = {\\\"request_id\\\": request_id}\\n            response.update(handle_run(str(request.get(\\\"arg\\\", \\\"\\\"))))\\n        else:\\n            response = {\\\"request_id\\\": request_id, \\\"status\\\": \\\"error\\\",\\n                        \\\"message\\\": f\\\"unknown op {op!r}\\\"}\\n        sys.stdout.write(json.dumps(response) + \\\"\\\\n\\\")\\n        sys.stdout.flush()\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"},\"weather\":{\"manifest.json\":\"{\\n  \\\"id\\\": \\\"weather\\\",\\n  \\\"name\\\": \\\"Weather\\\",\\n  \\\"version\\\": \\\"1.0.0\\\",\\n  \\\"author\\\": \\\"Fulcrum\\\",\\n  \\\"category\\\": \\\"Web\\\",\\n  \\\"description\\\": \\\"Current conditions and the next days for your location (`wx`) or a place (`wx Tokyo`), from wttr.in. ↵ copies a line.\\\",\\n  \\\"icon\\\": \\\"plugin\\\",\\n  \\\"entry\\\": {\\n    \\\"exec\\\": [\\n      \\\"python3\\\",\\n      \\\"weather.py\\\"\\n    ]\\n  },\\n  \\\"commands\\\": [\\n    {\\n      \\\"id\\\": \\\"forecast\\\",\\n      \\\"name\\\": \\\"Show the weather\\\",\\n      \\\"keyword\\\": \\\"wx\\\",\\n      \\\"description\\\": \\\"wx Tokyo\\\",\\n      \\\"example\\\": \\\"wx Tokyo\\\"\\n    }\\n  ],\\n  \\\"permissions\\\": [\\n    \\\"network\\\",\\n    \\\"clipboard-write\\\"\\n  ]\\n}\\n\",\"weather.py\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Weather — Fulcrum plugin (FPP1).\\n\\n`wx` shows the weather where you are (by IP), `wx Tokyo` for a place:\\ncurrent conditions, then today's and tomorrow's range. ↵ copies the\\nline. Uses wttr.in's JSON feed (no key).\\n\\\"\\\"\\\"\\n\\nimport json\\nimport subprocess\\nimport sys\\nimport urllib.parse\\nimport urllib.request\\n\\nTIMEOUT_SECONDS = 1.8\\n\\n\\ndef row(title, subtitle, arg):\\n    return {\\\"title\\\": title, \\\"subtitle\\\": subtitle, \\\"arg\\\": arg, \\\"icon\\\": \\\"plugin\\\"}\\n\\n\\ndef copy_to_clipboard(text):\\n    for command in ([\\\"pbcopy\\\"], [\\\"wl-copy\\\"], [\\\"xclip\\\", \\\"-selection\\\", \\\"clipboard\\\"],\\n                    [\\\"clip.exe\\\"]):\\n        try:\\n            subprocess.run(command, input=text.encode(\\\"utf-8\\\"), check=True,\\n                           timeout=2, stdout=subprocess.DEVNULL,\\n                           stderr=subprocess.DEVNULL)\\n            return True\\n        except (OSError, subprocess.SubprocessError):\\n            continue\\n    return False\\n\\n\\ndef first_value(entries, key):\\n    for entry in entries or []:\\n        value = entry.get(key)\\n        if isinstance(value, list) and value:\\n            return value[0].get(\\\"value\\\", \\\"\\\")\\n        if isinstance(value, str):\\n            return value\\n    return \\\"\\\"\\n\\n\\ndef handle_query(query):\\n    place = query.strip()\\n    url = \\\"https://wttr.in/\\\" + urllib.parse.quote(place) + \\\"?format=j1\\\"\\n    request = urllib.request.Request(url, headers={\\\"User-Agent\\\": \\\"fulcrum-weather-plugin\\\"})\\n    try:\\n        with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as response:\\n            payload = json.loads(response.read().decode(\\\"utf-8\\\"))\\n    except Exception:  # noqa: BLE001\\n        return [row(\\\"Weather unreachable\\\", \\\"offline or wttr.in not responding\\\", \\\"\\\")]\\n    current = (payload.get(\\\"current_condition\\\") or [{}])[0]\\n    area = (payload.get(\\\"nearest_area\\\") or [{}])[0]\\n    where = first_value([area], \\\"areaName\\\") or place or \\\"here\\\"\\n    country = first_value([area], \\\"country\\\")\\n    location = f\\\"{where}, {country}\\\" if country else where\\n    description = first_value([current], \\\"weatherDesc\\\")\\n    temp_c = current.get(\\\"temp_C\\\", \\\"?\\\")\\n    feels = current.get(\\\"FeelsLikeC\\\", \\\"?\\\")\\n    humidity = current.get(\\\"humidity\\\", \\\"?\\\")\\n    wind = current.get(\\\"windspeedKmph\\\", \\\"?\\\")\\n    now_line = f\\\"{temp_c}°C {description} · feels {feels}°C · {humidity}% humidity · wind {wind} km/h\\\"\\n    rows = [row(f\\\"{location}: {now_line}\\\", \\\"now · ↵ copies\\\", f\\\"{location}: {now_line}\\\")]\\n    labels = (\\\"Today\\\", \\\"Tomorrow\\\", \\\"Day after\\\")\\n    for label, day in zip(labels, payload.get(\\\"weather\\\", [])[:3]):\\n        hourly = day.get(\\\"hourly\\\") or []\\n        midday = hourly[len(hourly) // 2] if hourly else {}\\n        summary = first_value([midday], \\\"weatherDesc\\\")\\n        line = (f\\\"{label}: {day.get('mintempC', '?')}–{day.get('maxtempC', '?')}°C\\\"\\n                f\\\"{' · ' + summary if summary else ''}\\\"\\n                f\\\" · sunrise {first_value(day.get('astronomy'), 'sunrise')}\\\")\\n        rows.append(row(line, f\\\"{day.get('date', '')} · ↵ copies\\\", line))\\n    return rows\\n\\n\\ndef handle_run(arg):\\n    if not arg:\\n        return {\\\"status\\\": \\\"error\\\", \\\"message\\\": \\\"nothing to copy\\\"}\\n    if copy_to_clipboard(arg):\\n        return {\\\"status\\\": \\\"ok\\\"}\\n    return {\\\"status\\\": \\\"error\\\", \\\"message\\\": \\\"no clipboard tool found\\\"}\\n\\n\\ndef main():\\n    for line in sys.stdin:\\n        line = line.strip()\\n        if not line:\\n            continue\\n        try:\\n            request = json.loads(line)\\n        except json.JSONDecodeError:\\n            continue\\n        request_id = request.get(\\\"request_id\\\", 0)\\n        op = request.get(\\\"op\\\")\\n        if op == \\\"query\\\":\\n            response = {\\\"request_id\\\": request_id,\\n                        \\\"results\\\": handle_query(str(request.get(\\\"query\\\", \\\"\\\")))}\\n        elif op == \\\"run\\\":\\n            response = {\\\"request_id\\\": request_id}\\n            response.update(handle_run(str(request.get(\\\"arg\\\", \\\"\\\"))))\\n        else:\\n            response = {\\\"request_id\\\": request_id, \\\"status\\\": \\\"error\\\",\\n                        \\\"message\\\": f\\\"unknown op {op!r}\\\"}\\n        sys.stdout.write(json.dumps(response) + \\\"\\\\n\\\")\\n        sys.stdout.flush()\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"},\"wiki\":{\"manifest.json\":\"{\\n  \\\"id\\\": \\\"wiki\\\",\\n  \\\"name\\\": \\\"Wikipedia\\\",\\n  \\\"version\\\": \\\"1.0.0\\\",\\n  \\\"author\\\": \\\"Fulcrum\\\",\\n  \\\"category\\\": \\\"Web\\\",\\n  \\\"description\\\": \\\"Search English Wikipedia and open the article: title and opening line per result. Type `wiki` followed by a topic.\\\",\\n  \\\"icon\\\": \\\"plugin\\\",\\n  \\\"entry\\\": {\\n    \\\"exec\\\": [\\n      \\\"python3\\\",\\n      \\\"wiki.py\\\"\\n    ]\\n  },\\n  \\\"commands\\\": [\\n    {\\n      \\\"id\\\": \\\"search\\\",\\n      \\\"name\\\": \\\"Search Wikipedia\\\",\\n      \\\"keyword\\\": \\\"wiki\\\",\\n      \\\"description\\\": \\\"wiki fulcrum\\\",\\n      \\\"example\\\": \\\"wiki fulcrum\\\"\\n    }\\n  ],\\n  \\\"permissions\\\": [\\n    \\\"network\\\",\\n    \\\"open-url\\\"\\n  ]\\n}\\n\",\"wiki.py\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Wikipedia — Fulcrum plugin (FPP1).\\n\\n`wiki fulcrum` searches English Wikipedia: title and the opening line\\nof each article. ↵ opens the article. Public MediaWiki API, no key.\\n\\\"\\\"\\\"\\n\\nimport json\\nimport sys\\nimport urllib.parse\\nimport urllib.request\\nimport webbrowser\\n\\nTIMEOUT_SECONDS = 1.6\\nAPI = (\\\"https://en.wikipedia.org/w/api.php?action=query&list=search&format=json\\\"\\n       \\\"&srlimit=10&srprop=snippet&srsearch=\\\")\\n\\n\\ndef row(title, subtitle, arg):\\n    return {\\\"title\\\": title, \\\"subtitle\\\": subtitle, \\\"arg\\\": arg, \\\"icon\\\": \\\"plugin\\\"}\\n\\n\\ndef strip_tags(text):\\n    out = []\\n    inside = False\\n    for ch in text:\\n        if ch == \\\"<\\\":\\n            inside = True\\n        elif ch == \\\">\\\":\\n            inside = False\\n        elif not inside:\\n            out.append(ch)\\n    return \\\"\\\".join(out).replace(\\\"&quot;\\\", '\\\"').replace(\\\"&amp;\\\", \\\"&\\\").replace(\\\"&#039;\\\", \\\"'\\\")\\n\\n\\ndef handle_query(query):\\n    text = query.strip()\\n    if not text:\\n        return [row(\\\"Type a topic\\\", \\\"wiki fulcrum · wiki Racket (programming language) · ↵ opens\\\", \\\"\\\")]\\n    request = urllib.request.Request(API + urllib.parse.quote(text),\\n                                     headers={\\\"User-Agent\\\": \\\"fulcrum-wikipedia-plugin/1.0\\\"})\\n    try:\\n        with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as response:\\n            payload = json.loads(response.read().decode(\\\"utf-8\\\"))\\n    except Exception:  # noqa: BLE001\\n        return [row(\\\"Wikipedia unreachable\\\", \\\"offline or en.wikipedia.org not responding\\\", \\\"\\\")]\\n    rows = []\\n    for hit in payload.get(\\\"query\\\", {}).get(\\\"search\\\", []):\\n        title = hit.get(\\\"title\\\", \\\"\\\")\\n        if not title:\\n            continue\\n        snippet = strip_tags(hit.get(\\\"snippet\\\", \\\"\\\"))\\n        link = \\\"https://en.wikipedia.org/wiki/\\\" + urllib.parse.quote(title.replace(\\\" \\\", \\\"_\\\"))\\n        rows.append(row(title, f\\\"{snippet[:110]}… · ↵ opens\\\" if snippet else \\\"↵ opens\\\", link))\\n    if not rows:\\n        rows.append(row(\\\"No articles\\\", f\\\"nothing on Wikipedia for “{text}”\\\", \\\"\\\"))\\n    return rows[:10]\\n\\n\\ndef handle_run(arg):\\n    if not arg:\\n        return {\\\"status\\\": \\\"error\\\", \\\"message\\\": \\\"nothing to open\\\"}\\n    if webbrowser.open(arg):\\n        return {\\\"status\\\": \\\"ok\\\"}\\n    return {\\\"status\\\": \\\"error\\\", \\\"message\\\": \\\"no browser available\\\"}\\n\\n\\ndef main():\\n    for line in sys.stdin:\\n        line = line.strip()\\n        if not line:\\n            continue\\n        try:\\n            request = json.loads(line)\\n        except json.JSONDecodeError:\\n            continue\\n        request_id = request.get(\\\"request_id\\\", 0)\\n        op = request.get(\\\"op\\\")\\n        if op == \\\"query\\\":\\n            response = {\\\"request_id\\\": request_id,\\n                        \\\"results\\\": handle_query(str(request.get(\\\"query\\\", \\\"\\\")))}\\n        elif op == \\\"run\\\":\\n            response = {\\\"request_id\\\": request_id}\\n            response.update(handle_run(str(request.get(\\\"arg\\\", \\\"\\\"))))\\n        else:\\n            response = {\\\"request_id\\\": request_id, \\\"status\\\": \\\"error\\\",\\n                        \\\"message\\\": f\\\"unknown op {op!r}\\\"}\\n        sys.stdout.write(json.dumps(response) + \\\"\\\\n\\\")\\n        sys.stdout.flush()\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"},\"winget\":{\"manifest.json\":\"{\\n  \\\"id\\\": \\\"winget\\\",\\n  \\\"name\\\": \\\"Winget\\\",\\n  \\\"version\\\": \\\"1.0.0\\\",\\n  \\\"author\\\": \\\"Fulcrum\\\",\\n  \\\"category\\\": \\\"Developer\\\",\\n  \\\"description\\\": \\\"Search the Windows Package Manager catalog and copy install commands. Type `winget` followed by a query.\\\",\\n  \\\"icon\\\": \\\"plugin\\\",\\n  \\\"entry\\\": {\\n    \\\"exec\\\": [\\n      \\\"python3\\\",\\n      \\\"winget.py\\\"\\n    ]\\n  },\\n  \\\"commands\\\": [\\n    {\\n      \\\"id\\\": \\\"search\\\",\\n      \\\"name\\\": \\\"Search winget packages\\\",\\n      \\\"keyword\\\": \\\"winget\\\",\\n      \\\"description\\\": \\\"winget vscode · ↵ copies the `winget install` command\\\",\\n      \\\"example\\\": \\\"winget vscode\\\"\\n    }\\n  ],\\n  \\\"permissions\\\": [\\n    \\\"exec\\\",\\n    \\\"clipboard-write\\\"\\n  ]\\n}\\n\",\"winget.py\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Winget — package search for Fulcrum (FPP1).\\n\\n`winget <query>` searches the Windows Package Manager catalog through the\\nwinget CLI. Activating a row copies the matching `winget install` command\\nto the clipboard (via clip.exe). Windows only — every other platform gets\\na single notice row instead of results.\\n\\nFPP1 contract: one JSON object per line on stdin, one on stdout.\\n\\\"\\\"\\\"\\n\\nimport json\\nimport re\\nimport shutil\\nimport subprocess\\nimport sys\\n\\nTIMEOUT = 1.5  # every subprocess stays under the host's 2 s kill window\\nMAX_RESULTS = 8\\n\\n# winget prints a fixed-width table; columns are separated by runs of 2+\\n# spaces (ids and names never contain such runs, so this is a safe split).\\nCOLUMN_SPLIT = re.compile(r\\\"\\\\s{2,}\\\")\\n\\n\\ndef result_row(title, subtitle, arg):\\n    return {\\\"title\\\": title, \\\"subtitle\\\": subtitle, \\\"arg\\\": arg, \\\"icon\\\": \\\"plugin\\\"}\\n\\n\\ndef parse_table(output):\\n    \\\"\\\"\\\"Parse winget's table output into (name, id, version) tuples.\\n\\n    Real data rows start after the dashed separator line under the (possibly\\n    localized) header, so the separator is the anchor and the header itself\\n    is skipped without needing to know its text.\\n    \\\"\\\"\\\"\\n    lines = output.splitlines()\\n    start = -1\\n    for i, line in enumerate(lines):\\n        stripped = line.strip()\\n        if stripped and set(stripped) <= set(\\\"-\\\"):\\n            start = i + 1\\n            break\\n    if start < 0:\\n        return []\\n    rows = []\\n    for line in lines[start:]:\\n        if not line.strip():\\n            continue\\n        cells = COLUMN_SPLIT.split(line.strip())\\n        if len(cells) < 2:\\n            continue\\n        name, package_id = cells[0], cells[1]\\n        version = cells[2] if len(cells) >= 3 else \\\"\\\"\\n        rows.append((name, package_id, version))\\n    return rows\\n\\n\\ndef handle_query(query):\\n    if sys.platform != \\\"win32\\\":\\n        return [result_row(\\\"winget is only available on Windows\\\",\\n                           \\\"this plugin shells out to the winget CLI\\\", \\\"\\\")]\\n    text = query.strip()\\n    if not text:\\n        return [result_row(\\\"Winget package search\\\",\\n                           \\\"Type to search · ↵ copies the install command\\\",\\n                           \\\"\\\")]\\n    if shutil.which(\\\"winget\\\") is None:\\n        return [result_row(\\\"winget is not installed\\\",\\n                           \\\"install the App Installer package from Microsoft\\\",\\n                           \\\"\\\")]\\n    try:\\n        completed = subprocess.run(\\n            [\\\"winget\\\", \\\"search\\\", \\\"--query\\\", text, \\\"--disable-interactivity\\\"],\\n            capture_output=True, timeout=TIMEOUT)\\n    except (subprocess.SubprocessError, OSError):\\n        return [result_row(\\\"winget search failed\\\",\\n                           \\\"the CLI did not respond in time\\\", \\\"\\\")]\\n\\n    rows = []\\n    for name, package_id, version in parse_table(\\n            completed.stdout.decode(\\\"utf-8\\\", \\\"replace\\\"))[:MAX_RESULTS]:\\n        subtitle = f\\\"{package_id} · {version}\\\" if version else package_id\\n        rows.append(result_row(name, subtitle, package_id))\\n    if rows:\\n        return rows\\n    if completed.returncode != 0:\\n        # Surface a short reason from stderr when the CLI itself failed.\\n        reason = completed.stderr.decode(\\\"utf-8\\\", \\\"replace\\\").strip()\\n        reason = reason.splitlines()[0][:100] if reason else \\\"exit code \\\" \\\\\\n            f\\\"{completed.returncode}\\\"\\n        return [result_row(\\\"winget search failed\\\", reason, \\\"\\\")]\\n    return [result_row(\\\"No matching packages\\\",\\n                       f\\\"nothing in the catalog matches {text!r}\\\", \\\"\\\")]\\n\\n\\ndef copy_to_clipboard(text):\\n    # On Windows clip.exe reads the text from its standard input.\\n    if shutil.which(\\\"clip.exe\\\") is None:\\n        return False\\n    try:\\n        subprocess.run([\\\"clip.exe\\\"], input=text.encode(\\\"utf-8\\\"),\\n                       check=True, timeout=TIMEOUT)\\n        return True\\n    except (subprocess.SubprocessError, OSError):\\n        return False\\n\\n\\ndef handle_run(arg):\\n    package_id = arg.strip()\\n    if not package_id:\\n        return {\\\"status\\\": \\\"error\\\", \\\"message\\\": \\\"no package id given\\\"}\\n    command = f\\\"winget install --id {package_id} -e\\\"\\n    if copy_to_clipboard(command):\\n        return {\\\"status\\\": \\\"ok\\\", \\\"message\\\": command}\\n    return {\\\"status\\\": \\\"error\\\", \\\"message\\\": \\\"no clipboard tool found (clip.exe)\\\"}\\n\\n\\ndef main():\\n    try:\\n        request = json.loads(sys.stdin.readline())\\n    except (ValueError, json.JSONDecodeError):\\n        print(json.dumps({\\\"request_id\\\": 0, \\\"status\\\": \\\"error\\\",\\n                          \\\"message\\\": \\\"invalid request\\\"}))\\n        return\\n    request_id = request.get(\\\"request_id\\\", 0)\\n    try:\\n        if request.get(\\\"op\\\") == \\\"query\\\":\\n            response = {\\\"request_id\\\": request_id,\\n                        \\\"results\\\": handle_query(request.get(\\\"query\\\", \\\"\\\"))}\\n        elif request.get(\\\"op\\\") == \\\"run\\\":\\n            response = {\\\"request_id\\\": request_id}\\n            response.update(handle_run(request.get(\\\"arg\\\", \\\"\\\")))\\n        else:\\n            response = {\\\"request_id\\\": request_id, \\\"status\\\": \\\"error\\\",\\n                        \\\"message\\\": f\\\"unknown op: {request.get('op')}\\\"}\\n    except Exception as exc:  # never crash the protocol\\n        response = {\\\"request_id\\\": request_id, \\\"status\\\": \\\"error\\\",\\n                    \\\"message\\\": str(exc)}\\n    print(json.dumps(response))\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"},\"wordcount\":{\"manifest.json\":\"{\\n  \\\"id\\\": \\\"wordcount\\\",\\n  \\\"name\\\": \\\"Word Count\\\",\\n  \\\"version\\\": \\\"1.0.0\\\",\\n  \\\"author\\\": \\\"Fulcrum\\\",\\n  \\\"category\\\": \\\"Developer\\\",\\n  \\\"description\\\": \\\"Words, characters, lines, sentences and reading time. `wc some text` counts the text; a bare `wc` counts the clipboard.\\\",\\n  \\\"icon\\\": \\\"plugin\\\",\\n  \\\"entry\\\": {\\n    \\\"exec\\\": [\\n      \\\"python3\\\",\\n      \\\"wordcount.py\\\"\\n    ]\\n  },\\n  \\\"commands\\\": [\\n    {\\n      \\\"id\\\": \\\"count\\\",\\n      \\\"name\\\": \\\"Count words\\\",\\n      \\\"keyword\\\": \\\"wc\\\",\\n      \\\"description\\\": \\\"wc the quick brown fox\\\",\\n      \\\"example\\\": \\\"wc the quick brown fox\\\"\\n    }\\n  ],\\n  \\\"permissions\\\": [\\n    \\\"clipboard-read\\\",\\n    \\\"clipboard-write\\\"\\n  ]\\n}\\n\",\"wordcount.py\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Word Count — Fulcrum plugin (FPP1).\\n\\nCounts words, characters, lines and reading time. `wc some text` counts\\nthe typed text; a bare `wc` counts whatever is on the clipboard. ↵\\ncopies the one-line summary. Offline.\\n\\\"\\\"\\\"\\n\\nimport json\\nimport re\\nimport subprocess\\nimport sys\\n\\n\\ndef row(title, subtitle, arg):\\n    return {\\\"title\\\": title, \\\"subtitle\\\": subtitle, \\\"arg\\\": arg, \\\"icon\\\": \\\"plugin\\\"}\\n\\n\\ndef copy_to_clipboard(text):\\n    for command in ([\\\"pbcopy\\\"], [\\\"wl-copy\\\"], [\\\"xclip\\\", \\\"-selection\\\", \\\"clipboard\\\"],\\n                    [\\\"clip.exe\\\"]):\\n        try:\\n            subprocess.run(command, input=text.encode(\\\"utf-8\\\"), check=True,\\n                           timeout=2, stdout=subprocess.DEVNULL,\\n                           stderr=subprocess.DEVNULL)\\n            return True\\n        except (OSError, subprocess.SubprocessError):\\n            continue\\n    return False\\n\\n\\ndef read_clipboard():\\n    for command in ([\\\"pbpaste\\\"], [\\\"wl-paste\\\", \\\"--no-newline\\\"],\\n                    [\\\"xclip\\\", \\\"-selection\\\", \\\"clipboard\\\", \\\"-o\\\"],\\n                    [\\\"powershell\\\", \\\"-NoProfile\\\", \\\"-Command\\\", \\\"Get-Clipboard\\\"]):\\n        try:\\n            done = subprocess.run(command, check=True, timeout=2,\\n                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)\\n            return done.stdout.decode(\\\"utf-8\\\", errors=\\\"replace\\\")\\n        except (OSError, subprocess.SubprocessError):\\n            continue\\n    return \\\"\\\"\\n\\n\\ndef handle_query(query):\\n    text = query\\n    source = \\\"typed text\\\"\\n    if not text.strip():\\n        text = read_clipboard()\\n        source = \\\"clipboard\\\"\\n        if not text.strip():\\n            return [row(\\\"Nothing to count\\\", \\\"wc <text> · or copy something and type wc\\\", \\\"\\\")]\\n    words = re.findall(r\\\"\\\\S+\\\", text)\\n    cjk = len(re.findall(r\\\"[\\\\u4e00-\\\\u9fff\\\\u3040-\\\\u30ff\\\\uac00-\\\\ud7af]\\\", text))\\n    characters = len(text)\\n    no_spaces = len(re.sub(r\\\"\\\\s\\\", \\\"\\\", text))\\n    lines = text.count(\\\"\\\\n\\\") + (1 if text and not text.endswith(\\\"\\\\n\\\") else 0)\\n    sentences = len(re.findall(r\\\"[.!?。！？]+\\\", text)) or (1 if words else 0)\\n    word_total = len(words) + cjk  # CJK scripts carry no spaces: count characters as words\\n    minutes = max(1, round(word_total / 220)) if word_total else 0\\n    summary = (f\\\"{word_total} words · {characters} chars · {no_spaces} non-space · \\\"\\n               f\\\"{lines} lines · {sentences} sentences · ~{minutes} min read\\\")\\n    return [\\n        row(f\\\"{word_total} words\\\", f\\\"{source} · ↵ copies the summary\\\", summary),\\n        row(f\\\"{characters} characters\\\", f\\\"{no_spaces} without spaces · ↵ copies the summary\\\", summary),\\n        row(f\\\"{lines} lines · {sentences} sentences\\\", f\\\"~{minutes} min read at 220 wpm · ↵ copies\\\", summary),\\n    ]\\n\\n\\ndef handle_run(arg):\\n    if not arg:\\n        return {\\\"status\\\": \\\"error\\\", \\\"message\\\": \\\"nothing to copy\\\"}\\n    if copy_to_clipboard(arg):\\n        return {\\\"status\\\": \\\"ok\\\"}\\n    return {\\\"status\\\": \\\"error\\\", \\\"message\\\": \\\"no clipboard tool found\\\"}\\n\\n\\ndef main():\\n    for line in sys.stdin:\\n        line = line.strip()\\n        if not line:\\n            continue\\n        try:\\n            request = json.loads(line)\\n        except json.JSONDecodeError:\\n            continue\\n        request_id = request.get(\\\"request_id\\\", 0)\\n        op = request.get(\\\"op\\\")\\n        if op == \\\"query\\\":\\n            response = {\\\"request_id\\\": request_id,\\n                        \\\"results\\\": handle_query(str(request.get(\\\"query\\\", \\\"\\\")))}\\n        elif op == \\\"run\\\":\\n            response = {\\\"request_id\\\": request_id}\\n            response.update(handle_run(str(request.get(\\\"arg\\\", \\\"\\\"))))\\n        else:\\n            response = {\\\"request_id\\\": request_id, \\\"status\\\": \\\"error\\\",\\n                        \\\"message\\\": f\\\"unknown op {op!r}\\\"}\\n        sys.stdout.write(json.dumps(response) + \\\"\\\\n\\\")\\n        sys.stdout.flush()\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"}}")
