(define (emoji-count) (length emoji-entries))

;; Runtime hygiene: drop placeholder rows and duplicate characters, keep
;; the first spelling of each.
(define emoji-table
  (let loop ([entries emoji-entries] [seen '()] [acc '()])
    (if (null? entries)
        (reverse acc)
        (let ([e (car entries)])
          (if (or (member (list-ref e 0) seen)
                  (not (non-empty-string? (list-ref e 1))))
              (loop (cdr entries) seen acc)
              (loop (cdr entries) (cons (list-ref e 0) seen) (cons e acc)))))))

;; Score a query against one entry: name beats keywords, prefix beats
;; substring; a two-letter query must match the name to stay relevant.
(define (emoji-match-score query name keywords)
  (define q (string-downcase query))
  (define n (string-downcase name))
  (define k (string-downcase keywords))
  (cond
    [(string-prefix? n q) 30]
    [(string-contains? n q) 20]
    [(string-prefix? k q) 10]
    [(string-contains? k q) 5]
    [else #f]))

;; Best matches for a query, best first. Queries shorter than two
;; characters return nothing — one letter would match half the set.
(define/contract (emoji-search query [limit 4])
  (->* (string?) ((and/c exact-integer? (>/c 0)))
       (listof (list/c string? string?)))
  (define q (string-trim query))
  (if (< (string-length q) 2)
      '()
      (for/list ([entry (in-list
                         (take-min
                          (for/list ([entry (in-list emoji-table)]
                                     #:when (emoji-match-score
                                             q
                                             (list-ref entry 1)
                                             (list-ref entry 2)))
                            entry)
                          limit))]
                  #:when (>= (string-length (list-ref entry 0)) 1))
        ;; (char name) — the keywords stay internal.
        (list (list-ref entry 0) (list-ref entry 1)))))

(define (take-min xs n)
  (if (> (length xs) n) (take xs n) xs))
