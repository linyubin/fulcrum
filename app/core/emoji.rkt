#lang racket/base

;; Emoji search — the Raycast-style built-in: type a few letters, the
;; matching emoji appear inline, Enter inserts (paste-to-frontmost) the
;; character into the app you came from.
;;
;; The dataset is a curated compact set of popular emoji with English
;; keywords (not the full Unicode name table): it must stay cheap enough
;; to scan on every keystroke, and honest keywords beat exhaustive names
;; for recall. Local data, no network, no licensing concerns.

(require racket/contract
         racket/list
         racket/string)

(provide emoji-entries
         emoji-search
         emoji-count)

